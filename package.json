{
  "name": "payback-monorepo",
  "private": true,
  "devDependencies": {
    "lerna": "^8.1.2",
    "typescript": "^5.0.0",
    "husky": "^8.0.2"
  },
  "version": "0.0.18",
  "scripts": {
    "bootstrap": "pnpm install",
    "version": "lerna version --no-commit-hooks",
    "clean": "lerna clean && rm -rf ./node_modules",
    "clean:dist": "rm -rf ./packages/*/dist",
    "clean:cache": "rm -rf ./packages/*/node_modules/.cache",
    "build": "lerna run build",
    "publish:beta": "lerna publish --force-publish --dist-tag=beta --skip-git",
    "publish:latest": "lerna publish --force-publish --skip-git",
    "start": "lerna run start --scope='*/packages/client' --scope='*/packages/server'",
    "start:all": "lerna run start --parallel",
    "start:webhookServer": "cd packages/webhook-server && pnpm start",
    "start:pushServer": "cd packages/push-server && pnpm start",
    "start:wxPusher": "cd packages/wxPusher && pnpm start",
    "start:server": "cd packages/server && pnpm start",
    "start:client": "cd packages/client && pnpm start:test",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*/src/**/*.{js,vue}": "eslint --cache --fix",
    "*/src/**/*.{js,ts,wxml,wxss,html,json,css,less,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
