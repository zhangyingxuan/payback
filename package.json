{
  "name": "root",
  "private": true,
  "devDependencies": {
    "lerna": "^4.0.0"
  },
  "version": "0.0.12",
  "command": {
    "bootstrap": {
      "hoist": true
    }
  },
  "scripts": {
    "bootstrap": "lerna bootstrap --force-local",
    "clean": "lerna clean && rm -rf ./node_modules",
    "clean:dist": "rm -rf ./packages/*/dist",
    "clean:cache": "rm -rf ./packages/*/node_modules/.cache",
    "build": "lerna run build",
    "publish:beta": "lerna publish --force-publish --dist-tag=beta --skip-git",
    "publish:latest": "lerna publish --force-publish --skip-git",
    "start:wxPusher": "cd packages/wxPusher && pnpm start",
    "start:server": "cd packages/server && pnpm start",
    "start:client": "cd packages/client && pnpm start",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*/src/**/*.{js,vue}": "eslint --cache --fix",
    "*/src/**/*.{js,ts,wxml,wxss,html,json,css,less,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.0.9",
    "@kangc/v-md-editor": "^2.3.16",
    "@nestjs/cli": "^9.0.0",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^2.3.1",
    "@nestjs/core": "^9.0.0",
    "@nestjs/jwt": "^10.0.3",
    "@nestjs/mapped-types": "^1.2.2",
    "@nestjs/passport": "^9.0.3",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/schedule": "^2.2.1",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/swagger": "^6.3.0",
    "@nestjs/testing": "^9.0.0",
    "@nestjs/typeorm": "^9.0.1",
    "@types/express": "^4.17.13",
    "@types/jest": "29.5.0",
    "@types/js-cookie": "^3.0.3",
    "@types/lodash-es": "^4.17.7",
    "@types/node": "18.15.11",
    "@types/passport-jwt": "^3.0.8",
    "@types/passport-local": "^1.0.35",
    "@types/qs": "^6.9.7",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "@vitejs/plugin-vue": "^3.0.0",
    "@vue/compiler-sfc": "^3.1.2",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.3.6",
    "class-validator": "^0.14.0",
    "cropperjs": "^1.5.13",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.9",
    "echarts": "^5.4.2",
    "element-plus": "^2.2.14",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-vue": "^9.8.0",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "html-loader": "^4.2.0",
    "husky": "^8.0.2",
    "hyperdown": "^2.4.29",
    "jest": "29.5.0",
    "js-cookie": "^3.0.5",
    "less": "^4.1.3",
    "lint-staged": "^13.1.0",
    "lodash-es": "^4.17.21",
    "mysql": "^2.18.1",
    "node-fetch": "^2.6.9",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "path": "^0.12.7",
    "pinia": "^2.0.20",
    "playwright": "^1.32.3",
    "prettier": "^2.3.2",
    "qs": "^6.11.2",
    "raw-loader": "^4.0.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "29.0.5",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.2.0",
    "typeorm": "^0.3.15",
    "typescript": "^4.7.4",
    "unplugin-auto-import": "^0.11.2",
    "unplugin-vue-components": "^0.22.4",
    "vite": "^3.0.0",
    "vite-plugin-vue-setup-extend": "^0.4.0",
    "vue": "^3.2.37",
    "vue-cropperjs": "^5.0.0",
    "vue-router": "^4.1.3",
    "vue-schart": "^2.0.0",
    "vue-tsc": "^0.38.4",
    "webpack": "^5.11.0"
  }
}
